---
import Base from '../layouts/Base.astro';
---

<Base
  title="Discover"
  description="Hand-picked and trending Mac apps and command-line tools you can install with Homebrew."
>
  <div class="page">
    <div class="intro">
      <div class="heading">
        <h1>Discover</h1>
        <p>Hand-picked and trending Mac apps, updated every day.</p>
      </div>
      <form action="/search" role="search" class="search-pill">
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="var(--text-meta)"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4-4"></path>
        </svg>
        <label for="discover-q" class="visually-hidden">
          Search apps
        </label>
        <input id="discover-q" name="q" type="search" placeholder="Search apps and tools" />
        <button type="submit">Search</button>
      </form>
    </div>
  </div>
</Base>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 40px var(--gutter) 0;
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 40px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 17px;
  }

  .search-pill {
    flex: 1 1 300px;
    max-width: 460px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 20px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-search);
  }

  .search-pill:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  input {
    flex: 1;
    min-width: 0;
    height: var(--touch);
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 17px;
    color: var(--ink);
    outline: none;
  }

  button {
    height: var(--touch);
    padding: 0 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--surface);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
