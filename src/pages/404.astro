---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex description="This page doesn’t exist on Brewhunt.">
  <div class="page">
    <h1>Page not found</h1>
    <p>This page doesn’t exist, or hasn’t been built yet.</p>
    <a href="/discover">Go to Discover</a>
  </div>
</Base>

<script>
  // A renamed package or a formula alias (/app/python) moves on to its current page.
  const match = location.pathname.match(/^\/app\/(.+?)(?:\.html)?\/?$/);
  if (match) {
    fetch('/aliases.json')
      .then((res) => (res.ok ? (res.json() as Promise<Record<string, string>>) : {}))
      .then((aliases) => {
        const id = aliases[decodeURIComponent(match[1])];
        if (id) location.replace(`/app/${id}${location.search}${location.hash}`);
      })
      .catch(() => {});
  }
</script>

<style>
  .page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 40px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  p {
    margin: 0 0 8px;
    color: var(--text-secondary);
    font-size: 17px;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
</style>
