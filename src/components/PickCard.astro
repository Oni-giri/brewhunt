---
// An editor's pick as a column card (the landing page): the icon on a sky stage standing in
// for a screenshot (there are none until a developer claims the listing), name, meta line,
// Get and the editors' blurb. Put cards in a list.
import type { EditorsPick } from '../../scripts/content/schema.ts';
import type { Entry } from '../lib/catalog';
import { pickMeta } from '../lib/discover';
import AppIcon from './AppIcon.astro';
import Badge from './Badge.astro';
import GetButton from './GetButton.astro';

interface Props {
  pick: EditorsPick;
  entry: Entry;
}

const { pick, entry } = Astro.props;
---

<li class="card">
  {/* Same destination as the name link below, so it's skipped by Tab and screen readers. */}
  <a class="stage lift" href={entry.url} tabindex="-1" aria-hidden="true">
    <AppIcon pkg={entry} size={96} raised />
  </a>
  <div class="id">
    <a class="main" href={entry.url}>
      <AppIcon pkg={entry} size={60} class="icon" />
      <span class="titles">
        <h3>{entry.name}</h3>
        <span class="meta">
          {pickMeta(entry)}
          {entry.source === 'community' && <Badge variant="community">Community</Badge>}
        </span>
      </span>
    </a>
    <GetButton entry={entry} />
  </div>
  <p class="blurb">{pick.blurb}</p>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .stage {
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-code);
    text-decoration: none;
    background:
      radial-gradient(
        ellipse 60% 40% at 50% 110%,
        rgba(255, 255, 255, 0.9),
        rgba(255, 255, 255, 0) 70%
      ),
      linear-gradient(180deg, #2459d8, #a9cff6);
  }
  .id {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .main {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .main :global(.icon) {
    box-shadow:
      inset 0 1.5px 0 rgba(255, 255, 255, 0.5),
      0 10px 20px -12px rgba(8, 25, 80, 0.45);
  }
  .titles {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .main:hover h3 {
    text-decoration: underline;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .blurb {
    margin: 0;
    font-size: 17px;
    color: var(--text-body);
  }
</style>
