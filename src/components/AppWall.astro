---
// The landing page's "app wall": tilted rows of app chips sliding sideways in a loop, with a
// Pause toggle. Pure CSS animation; the script only wires the toggle. Each row repeats its
// chips once so the loop is seamless: the copies are hidden from assistive tech and skipped
// by Tab. Rows pause on hover and keyboard focus, and stand still for reduced motion.
import type { Entry } from '../lib/catalog';
import AppIcon from './AppIcon.astro';

export interface WallRow {
  entries: Entry[];
  /** Seconds for one full loop. */
  duration: number;
  /** Slide right instead of left. */
  reverse?: boolean;
  /** Dark chips (the command-line row). */
  dark?: boolean;
}

interface Props {
  rows: WallRow[];
  /** Accessible name of the wall, e.g. "Popular apps and tools". */
  label: string;
}

const { rows, label } = Astro.props;
---

<div class="app-wall" data-wall>
  <section class="wall" aria-label={label}>
    {rows.map((row) => (
      <div class:list={['row', { dark: row.dark }]}>
        <ul class:list={['track', { reverse: row.reverse }]} style={`--duration:${row.duration}s`}>
          {[false, true].map((copy) =>
            row.entries.map((entry) => (
              <li aria-hidden={copy ? 'true' : undefined}>
                <a class="chip lift" href={entry.url} tabindex={copy ? -1 : undefined}>
                  <AppIcon pkg={entry} size={56} />
                  <span class="text">
                    <span class="name">{entry.name}</span>
                    {entry.line && <span class="line">{entry.line}</span>}
                  </span>
                </a>
              </li>
            )),
          )}
        </ul>
      </div>
    ))}
  </section>
  <div class="controls">
    <button
      type="button"
      class="pause"
      aria-pressed="false"
      aria-label="Pause the app wall"
      data-wall-pause
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
      </svg>
      Pause
    </button>
  </div>
</div>

<script>
  // A toggle (aria-pressed) with a fixed label: pressed means paused.
  for (const wall of document.querySelectorAll<HTMLElement>('[data-wall]')) {
    const button = wall.querySelector<HTMLButtonElement>('[data-wall-pause]');
    button?.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      wall.toggleAttribute('data-paused', paused);
    });
  }
</script>

<style>
  .app-wall {
    position: relative;
  }

  .wall {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 10px 0 30px;
    transform: perspective(1600px) rotateX(14deg);
    transform-origin: 50% 0;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    mask-image: linear-gradient(90deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }

  .row {
    overflow: hidden;
  }

  /* Two copies of the chips side by side; sliding by half the width lands the second copy
     exactly where the first started. Margins rather than `gap`, so the half includes the
     space after the last chip and the loop doesn't jump. */
  .track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: wall-left var(--duration) linear infinite;
  }
  .track.reverse {
    animation-name: wall-right;
  }
  .track > li {
    display: flex;
    flex: none;
    margin-right: 16px;
  }

  @keyframes wall-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes wall-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .wall:hover .track,
  .wall:focus-within .track,
  .app-wall[data-paused] .track {
    animation-play-state: paused;
  }

  /* Keyboard focus: put the row back at its start. A chip that has slid off to the left can't
     be scrolled back into view; from the start, the browser scrolls the row to whichever chip
     has focus (kept clear of the faded edges by scroll-margin). */
  .row:has(:focus-visible) .track {
    animation: none;
  }

  .chip {
    width: 270px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: var(--radius-card);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    box-shadow: 0 18px 40px -22px rgba(8, 25, 80, 0.55);
    scroll-margin-inline: 15vw;
  }
  .chip:hover {
    color: var(--ink);
  }
  .dark .chip {
    background: #1a1c24;
    color: var(--code-dark-text);
  }
  /* The terminal tile is near-black: lighten it so it shows on a dark chip. */
  .dark .chip :global(.app-icon[data-tile='terminal']:not(.has-icon)) {
    background: linear-gradient(160deg, #3a3d48, #22242c);
  }

  .text {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .name,
  .line {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .name {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .line {
    font-size: 13px;
    opacity: 0.75;
  }

  /* landing.html lines the button up 24px outside the page column. */
  .controls {
    display: flex;
    justify-content: flex-end;
    max-width: calc(var(--content-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .pause {
    display: flex;
    align-items: center;
    gap: 8px;
    height: var(--touch);
    padding: 0 16px;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 6px 16px -10px rgba(8, 25, 80, 0.5);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .pause:hover {
    background: var(--surface);
  }
  .pause[aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .track.reverse {
      animation: none;
    }
    /* Still rows: let people scroll them by hand, and show each app once. */
    .row {
      overflow-x: auto;
    }
    .track > li[aria-hidden='true'] {
      display: none;
    }
    /* Nothing moves, so there's nothing to pause. */
    .controls {
      display: none;
    }
  }
</style>
