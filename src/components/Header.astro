---
import { getCatalog } from '../lib/catalog';
import Badge from './Badge.astro';
import Wordmark from './Wordmark.astro';
import { isCurrent, mainNav } from './nav';

interface Props {
  /** `landing`: frosted pill floating over the landing page's sky, with "Browse apps". */
  variant?: 'default' | 'landing';
}

const { variant = 'default' } = Astro.props;
const landing = variant === 'landing';
const { pathname } = Astro.url;
// The suggestions file (src/pages/search-suggest.json.ts), fetched on first focus.
const suggestUrl = `/search-suggest.json?v=${getCatalog().meta.generatedOn}`;
---

<div class:list={['header-wrap', { landing }]}>
  <header class="header" data-header>
    <Wordmark />
    <nav class="nav-links" aria-label="Main">
      {mainNav.map((link) => (
        <a href={link.href} aria-current={isCurrent(link, pathname) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <span class="actions">
      <button
        type="button"
        class="icon-btn search-btn"
        aria-label="Search"
        aria-expanded="false"
        aria-controls="header-search"
        data-search-toggle
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4-4"></path>
        </svg>
      </button>
      {landing && (
        <a class="browse" href="/discover">
          Browse apps
        </a>
      )}
      <button
        type="button"
        class="icon-btn menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="header-menu"
        data-menu-toggle
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </span>

    <nav id="header-menu" class="menu" aria-label="Main (mobile)" hidden data-menu>
      {mainNav.map((link) => (
        <a href={link.href} aria-current={isCurrent(link, pathname) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <form
      id="header-search"
      class="search"
      action="/search"
      role="search"
      hidden
      data-search
      data-suggest-src={suggestUrl}
    >
      <svg
        width="17"
        height="17"
        viewBox="0 0 24 24"
        fill="none"
        stroke="var(--text-meta)"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-4-4"></path>
      </svg>
      <label for="header-q" class="visually-hidden">
        Search apps
      </label>
      <input
        id="header-q"
        name="q"
        type="search"
        placeholder="Search apps and tools"
        autocomplete="off"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="header-suggest"
      />
      <button type="submit">Search</button>
      <div id="header-suggest" class="suggest" role="listbox" aria-label="Suggestions" hidden></div>
      <template data-suggest-community>
        <Badge variant="community">Community</Badge>
      </template>
    </form>
  </header>
</div>

<script>
  import { iconImage } from '../lib/icon-image';
  import { tileFor } from '../lib/tiles';

  // Menu and search dropdowns: one open at a time, focus moves in on open,
  // Escape or a click outside closes and returns focus to the toggle.
  const header = document.querySelector<HTMLElement>('[data-header]');

  if (header) {
    const panels = {
      menu: {
        toggle: header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!,
        panel: header.querySelector<HTMLElement>('[data-menu]')!,
        focusTarget: () => header.querySelector<HTMLElement>('[data-menu] a'),
      },
      search: {
        toggle: header.querySelector<HTMLButtonElement>('[data-search-toggle]')!,
        panel: header.querySelector<HTMLElement>('[data-search]')!,
        focusTarget: () => header.querySelector<HTMLElement>('[data-search] input'),
      },
    };
    type Name = keyof typeof panels;

    const isOpen = (name: Name) => !panels[name].panel.hidden;

    const setOpen = (name: Name, open: boolean) => {
      panels[name].panel.hidden = !open;
      panels[name].toggle.setAttribute('aria-expanded', String(open));
      if (name === 'search' && !open) suggestions.hide();
    };

    const close = (name: Name, restoreFocus: boolean) => {
      if (!isOpen(name)) return;
      setOpen(name, false);
      if (restoreFocus) panels[name].toggle.focus();
    };

    const suggestions = suggest(panels.search.panel as HTMLFormElement);

    for (const name of Object.keys(panels) as Name[]) {
      panels[name].toggle.addEventListener('click', () => {
        const open = !isOpen(name);
        for (const other of Object.keys(panels) as Name[]) setOpen(other, false);
        setOpen(name, open);
        if (open) panels[name].focusTarget()?.focus();
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      for (const name of Object.keys(panels) as Name[]) {
        if (isOpen(name) && header.contains(document.activeElement)) close(name, true);
        else close(name, false);
      }
    });

    // The menu only exists under 760px; close it if the viewport grows past that.
    const desktop = window.matchMedia('(min-width: 761px)');
    desktop.addEventListener('change', () => {
      if (!desktop.matches || !isOpen('menu')) return;
      const hadFocus = panels.menu.panel.contains(document.activeElement);
      setOpen('menu', false);
      if (hadFocus) header.querySelector<HTMLElement>('.nav-links a')?.focus();
    });

    document.addEventListener('click', (event) => {
      if (header.contains(event.target as Node)) return;
      for (const name of Object.keys(panels) as Name[]) close(name, false);
    });
  }

  /**
   * Suggestions under the header search (a WAI-ARIA combobox): from 2 characters, the 6 best
   * matches among the most installed packages, scored by the same code as /search, then "See all
   * results". Arrows move through them, Enter opens the highlighted one (or searches when none
   * is), Escape closes the list. Nothing loads until the search is first focused.
   */
  function suggest(form: HTMLFormElement) {
    const input = form.querySelector('input')!;
    const list = form.querySelector<HTMLElement>('[role="listbox"]')!;
    const community = form.querySelector<HTMLTemplateElement>('[data-suggest-community]')!.content
      .firstElementChild!;
    const SHOWN = 6;
    type Lib = typeof import('../lib/search');
    let lib: Lib | null = null;
    let data: ReturnType<Lib['prepare']> | null = null;
    let loading: Promise<void> | null = null;
    let active = -1;

    const options = () => [...list.querySelectorAll<HTMLAnchorElement>('[role="option"]')];

    const load = () =>
      (loading ??= Promise.all([
        import('../lib/search'),
        fetch(form.dataset.suggestSrc!).then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        }),
      ])
        .then(([module, index]) => {
          lib = module;
          data = module.prepare(index);
          if (!list.hidden) render();
        })
        // Try again on the next focus; meanwhile "See all results" still works.
        .catch(() => void (loading = null)));

    const highlight = (next: number) => {
      const all = options();
      active = next;
      all.forEach((option, i) => option.setAttribute('aria-selected', String(i === active)));
      if (active < 0) input.removeAttribute('aria-activedescendant');
      else {
        input.setAttribute('aria-activedescendant', all[active].id);
        all[active].scrollIntoView({ block: 'nearest' });
      }
    };

    const hide = () => {
      list.hidden = true;
      list.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      highlight(-1);
    };

    function option(id: string, href: string): HTMLAnchorElement {
      const a = document.createElement('a');
      a.id = id;
      a.href = href;
      a.tabIndex = -1;
      a.setAttribute('role', 'option');
      a.setAttribute('aria-selected', 'false');
      return a;
    }

    function row(item: ReturnType<Lib['prepare']>['items'][number], i: number) {
      const a = option(`header-suggest-${i}`, `/app/${item.id}`);
      const { tile, initials, mono } = tileFor({ ...item, commandLine: item.cliCask });
      const icon = document.createElement('span');
      icon.className = 'app-icon';
      icon.classList.toggle('mono', mono);
      icon.classList.toggle('has-icon', !!item.icon);
      icon.dataset.tile = tile;
      icon.setAttribute('aria-hidden', 'true');
      icon.style.cssText = `--size:36px;--radius:8px;--font:${mono ? 12 : 14}px`;
      icon.textContent = initials;
      if (item.icon) icon.append(iconImage(item.icon, 36));

      const text = document.createElement('span');
      text.className = 'text';
      const title = document.createElement('span');
      title.className = 'title';
      const name = document.createElement('span');
      name.className = 'name';
      name.textContent = item.name;
      title.append(name);
      // Official vs Community stays visible everywhere a package is listed.
      if (item.source === 'community') title.append(community.cloneNode(true));
      text.append(title);
      if (item.line) {
        const line = document.createElement('span');
        line.className = 'line';
        line.textContent = item.line;
        text.append(line);
      }
      a.append(icon, text);
      return a;
    }

    function render() {
      const q = input.value.trim();
      if (q.length < 2) return hide();
      const found =
        lib && data
          ? lib.search(data, q, lib.DEFAULT_STATE, 'relevance').items.slice(0, SHOWN)
          : [];
      const all = option('header-suggest-all', `/search?${new URLSearchParams({ q })}`);
      all.className = 'all';
      all.textContent = `See all results for “${q}”`;
      list.replaceChildren(...found.map(row), all);
      list.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      highlight(-1);
    }

    input.addEventListener('focus', load);
    input.addEventListener('input', () => {
      load();
      render();
    });

    input.addEventListener('keydown', (event) => {
      const count = options().length;
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (list.hidden) return render();
        const step = event.key === 'ArrowDown' ? 1 : -1;
        // Wraps through "nothing highlighted", where Enter searches.
        highlight(((active + 1 + step + count + 1) % (count + 1)) - 1);
      } else if (event.key === 'Enter' && !list.hidden && active >= 0) {
        event.preventDefault();
        location.assign(options()[active].href);
      } else if (event.key === 'Escape' && !list.hidden) {
        // Only the list, keeping the text: a second Escape closes the search (the header's
        // handler).
        event.preventDefault();
        event.stopPropagation();
        hide();
      }
    });

    // Keeps focus in the input while an option is pressed (Safari doesn't focus links on click,
    // so the list would close under the pointer).
    list.addEventListener('mousedown', (event) => event.preventDefault());
    // Leaving the search for anything but an option closes the list.
    form.addEventListener('focusout', (event) => {
      if (!list.contains(event.relatedTarget as Node | null)) hide();
    });

    return { hide };
  }
</script>

<style>
  .header-wrap {
    position: relative;
    z-index: 5;
    padding: 20px var(--gutter) 0;
  }

  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* The design sizes the pill's content box: 1112px + padding + border = 1140px outer. */
    box-sizing: content-box;
    max-width: var(--header-max);
    margin: 0 auto;
    padding: 8px 8px 8px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-header);
    color: var(--ink);
    /* Stays put while the page under it fades (global.css). */
    view-transition-name: site-header;
  }

  .nav-links {
    display: flex;
    gap: 4px 22px;
    font-size: 15px;
  }

  .nav-links a,
  .menu a {
    color: var(--ink);
    text-decoration: none;
  }

  .nav-links a {
    padding: 12px 0;
  }

  .nav-links a[aria-current='page'],
  .menu a[aria-current='page'] {
    font-weight: 700;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--touch);
    height: var(--touch);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .search-btn {
    background: var(--chip);
    color: var(--ink);
  }

  .menu-btn {
    display: none;
    background: var(--ink);
    color: var(--surface);
  }

  /* Landing page: the pill floats over the sky hero (which leaves room for it at the top),
     frosted and borderless as in landing.html. */
  .landing {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  .landing .header {
    max-width: var(--landing-header-max);
    border: 0;
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: 0 10px 30px -16px rgba(8, 25, 80, 0.45);
  }

  .browse {
    display: flex;
    align-items: center;
    height: var(--touch);
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--surface);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }

  .browse:hover {
    background: #000;
    color: var(--surface);
  }

  /* landing.html hides it under 760px (it goes to Discover, which the menu has); it also needs
     the room until the nav links fit beside it. */
  @media (max-width: 900px) {
    .browse {
      display: none;
    }
  }

  .menu,
  .search {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-dropdown);
  }

  .menu {
    display: flex;
    flex-direction: column;
    padding: 8px;
    border-radius: var(--radius-card);
  }

  .menu a {
    padding: 12px 14px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 20px;
    border-radius: var(--radius-pill);
  }

  .menu[hidden],
  .search[hidden] {
    display: none;
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: var(--touch);
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 17px;
    color: var(--ink);
    outline: none;
  }

  .search:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .search button {
    height: var(--touch);
    padding: 0 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--surface);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .suggest {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 6px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-dropdown);
  }

  .suggest[hidden] {
    display: none;
  }

  .suggest :global([role='option']) {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--touch);
    padding: 6px 10px;
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .suggest :global([role='option']:hover),
  .suggest :global([aria-selected='true']) {
    background: var(--chip);
  }

  .suggest :global(.text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .suggest :global(.title) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  .suggest :global(.name) {
    overflow: hidden;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .suggest :global(.line) {
    overflow: hidden;
    /* Not --text-meta, which is too faint on the highlighted row's grey. */
    color: var(--text-secondary);
    font-size: 14px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .suggest :global(.all) {
    padding-left: 14px;
    font-weight: 600;
  }

  .suggest :global(.all:not(:first-child)) {
    margin-top: 2px;
    border-top: 1px solid var(--border);
    border-radius: 0 0 12px 12px;
  }

  @media (max-width: 760px) {
    .nav-links {
      display: none;
    }

    .menu-btn {
      display: flex;
    }
  }

  @media (min-width: 761px) {
    .menu {
      display: none;
    }
  }
</style>
