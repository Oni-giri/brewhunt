---
// Initial-letter tile standing in for an app icon. Decorative: the name is always next to it.
// Styles are global (global.css) so the install sheet can draw the same tile from script.
import { tileFor, type TileName, type Tileable } from '../lib/tiles';

interface Props {
  pkg: Tileable;
  /** Edge length in px (the designs use 40, 44, 48, 52, 56, 60 and 112). */
  size?: number;
  /** Colour of a 2px ring, for overlapping stacks. */
  ring?: string;
  /** The big page-header icon with highlight and drop shadow. */
  raised?: boolean;
  class?: string;
}

const { pkg, size = 48, ring, raised = false, class: className } = Astro.props;
const { tile, initials, mono }: { tile: TileName; initials: string; mono: boolean } = tileFor(pkg);
const radius = Math.round(size * 0.225);
const fontSize = Math.round(size * (mono ? 0.34 : 0.39));
---

<span
  class:list={['app-icon', { mono, raised }, className]}
  data-tile={tile}
  style={`--size:${size}px;--radius:${radius}px;--font:${fontSize}px;${ring ? `--ring:${ring};` : ''}`}
  aria-hidden="true"
>
  {initials}
</span>
