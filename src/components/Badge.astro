---
// Pills next to names. "Official" is solid ink, "Community" dashed: always shown so people know
// whether Homebrew reviewed a package. `info` is a neutral white pill.
interface Props {
  variant: 'official' | 'community' | 'info' | 'warning';
  /** `sm` (20px) in lists, `md` (24px) in page headers. */
  size?: 'sm' | 'md';
}

const { variant, size = 'sm' } = Astro.props;
---

<span class:list={['badge', variant, size]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    flex: none;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    line-height: 1;
    font-weight: 600;
    color: var(--ink);
  }
  .sm {
    height: 20px;
    padding: 0 8px;
    font-size: 12px;
  }
  .md {
    height: 24px;
    padding: 0 12px;
    font-size: 13px;
  }
  .official {
    background: var(--ink);
    color: #fff;
  }
  .community {
    border: 1px dashed var(--text-secondary);
  }
  .info {
    background: var(--surface);
    border: 1px solid var(--border);
    font-weight: 400;
  }
  .warning {
    background: #fff4e0;
    border: 1px solid #f2c779;
    color: #6b4300;
  }
</style>
