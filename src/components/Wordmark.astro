---
// Flask + "Brewhunt", aligned to the flask's body (design/README.md → Brand assets).
interface Props {
  href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="wordmark" href={href}>
  <img src="/brewhunt-flask-128.png" alt="" width="46" height="46" />
  <span>Brewhunt</span>
</a>

<style>
  .wordmark {
    display: flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .wordmark:hover {
    color: inherit;
  }

  img {
    display: block;
    flex: none;
    width: 46px;
    height: 46px;
    margin: -8px -2px -6px -6px;
  }

  span {
    font-size: 20px;
    letter-spacing: -0.035em;
    margin-top: 3px;
  }
</style>
