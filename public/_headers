# Cloudflare Pages headers. Hashed build assets never change; everything else is rebuilt daily.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The Content-Security-Policy is a second line of defence for crawled text and URLs: no inline
# scripts, no other site's scripts or styles. Style attributes stay allowed (tile sizes and
# colours set at build time, never crawled text). Images: the site and jsDelivr (CaskFlow's
# icons); the crawler's asset domain joins img-src once it exists. The browser tests apply this
# line to every page (tests/browser/fixtures.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https://cdn.jsdelivr.net; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
